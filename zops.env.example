# ═══ Z-OPS 运维智能体 — 主配置 ═══

# ═══ LLM ═══
LLM_PROVIDER=
LLM_MODEL=
DEEPSEEK_API_KEY=

# 可选多 Provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# OneAPI 统一网关 (支持多模型 token 管理)
ONEAPI_API_KEY=
ONEAPI_BASE_URL=

# ═══ Redis ═══
REDIS_URL=

# ═══ SSH (ops_agent / dev_agent 使用) ═══
SHELL_TIMEOUT=
SSH_TIMEOUT=

# ═══ 虚拟化平台 (vm_agent 使用) ═══
VCENTER_HOST=
VCENTER_USER=
VCENTER_PASS=
PVE_HOST=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
KVM_HOSTS=

# ═══ 网络设备 (network_agent 使用) ═══
NETMIKO_DEVICE_TYPE=
SNMP_COMMUNITY=

# ═══ GCOC 平台 (gcoc_agent 使用) ═══
# 信息管理系统 (CMDB/监控/机柜/案例/DNS)
GCOC_INFO_URL=
GCOC_INFO_USER=
GCOC_INFO_PASS=

# 管理平台 (BRR备份/快照/VCD/Aria Ops)
GCOC_MGT_URL=
GCOC_MGT_USER=
GCOC_MGT_PASS=

# ═══ 知识库 KB (kb_agent / RAG 增强) ═══
KB_API_URL=
KB_API_TOKEN=
KB_SEARCH_LIMIT=
KB_RAG_ENABLED=

# ═══ HA VM 高可用信息 (HA Agent) ═══
HA_API_URL=
HA_API_TOKEN=

# ═══ 用户认证 ═══
WEBCHAT_AUTH_USER=
WEBCHAT_AUTH_PASS=
JWT_SECRET=
TOKEN_TTL=

# ═══ LDAP / AD 认证 ═══
LDAP_ENABLED=
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

# ═══ Telegram 通道 (v2.0 新增) ═══
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ═══ 企业微信通道 (v2.0 新增) ═══
WECOM_WEBHOOK_URL=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# ═══ MCP (Model Context Protocol) 外部工具集成 ═══
# 通过 MCP 协议集成外部工具服务 (如 gcoc-mgt)
MCP_ENABLED=true
MCP_SSE_ENDPOINT=https://gcoc-mgt.example.com/mcp/sse
MCP_REST_BASE=https://gcoc-mgt.example.com/api/snapshot/mcp/tools
MCP_TIMEOUT=30
MCP_VERIFY_SSL=true

# ═══ NMS SSL 证书调查闭环 ═══
# 1=允许创建调查与后台恢复跟踪；0=只保留历史只读
NMS_SSL_WORKFLOW_ENABLED=true
# 恢复门槛：证书链可信 + 域名匹配 + 剩余有效期至少 N 天
NMS_SSL_MIN_DAYS=30
# 服务端允许取证的端口（逗号分隔，默认仅 443）
NMS_SSL_ALLOWED_PORTS=443
# 不在白名单的端口转「人工核验模式」：不做 TLS 探测，需 NMS 清除持续该秒数才恢复
NMS_SSL_MANUAL_QUIET_S=1800
# 可选额外 CA（PEM 路径；留空只用系统信任库）
NMS_SSL_CA_FILE=
# 连续健康次数 / 相邻最小间隔秒 / 最小跨度秒
NMS_SSL_CONSECUTIVE_HEALTHY=3
NMS_SSL_HEALTHY_MIN_SPACING_S=60
NMS_SSL_HEALTHY_MIN_SPAN_S=120
# 复核间隔秒 / 跟踪窗口秒（到期自动暂停）
NMS_SSL_CHECK_INTERVAL=60
NMS_SSL_TRACK_WINDOW_S=86400
# 每用户最大活跃调查数 / 全局并发探测数
NMS_SSL_MAX_ACTIVE_PER_USER=10
NMS_SSL_GLOBAL_CONCURRENCY=2
# 指标汇总日志间隔秒（<=0 关闭周期汇总）
NMS_SSL_METRICS_LOG_INTERVAL_S=300

# ═══ Computer Use 服务端上限 ═══
# 真实桌面接管默认不进入服务端上限；开启后本机仍须 Windows 实机验收+逐次原生批准。
ZOPS_CU_DESKTOP_CEILING=false
# 已登记脚本默认放行（本机另需显式登记+哈希匹配）；设为 false 可整体收紧。
ZOPS_CU_SCRIPT_CEILING=true
