{
  "name": "每周用量报告 v2",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "value": "0 9 * * 1"
            }
          ]
        }
      },
      "id": "wr1",
      "name": "每周一9点",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        400
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "weekly-usage-report",
        "options": {}
      },
      "id": "wr0",
      "name": "手动Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        250
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:7789/api/usage/current",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Key",
              "value": "n8n_webhook_secret_2024"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "wr2",
      "name": "获取用量统计",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "http://localhost:7789/api/logs?limit=100",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Key",
              "value": "n8n_webhook_secret_2024"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "wr3",
      "name": "获取审计日志",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        450
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const cstDate = new Date().toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' });\nconst cstTime = new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });\n\nlet usage = {};\nlet logCount = 0;\n\ntry { usage = $('获取用量统计').first().json || {}; } catch(e) {}\ntry { logCount = ($('获取审计日志').first().json?.logs || []).length; } catch(e) {}\n\nconst report = {\n  title: `📊 Z-OPS 每周用量报告 - ${cstDate}`,\n  sections: [\n    `📈 LLM 调用: ${usage.total_calls || 0} 次`,\n    `🔢 Token 用量: ${usage.total_tokens || 0}`,\n    `💰 预估费用: ¥${((usage.total_tokens || 0) * 0.00002).toFixed(2)}`,\n    `📝 审计日志: ${logCount} 条 (近100条)`,\n  ],\n  timestamp: cstTime,\n};\n\nreturn report;"
      },
      "id": "wr4",
      "name": "生成报告",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        350
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:7789/api/n8n/webhook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'health_report', report: { overall_status: 'info', title: $json.title, sections: $json.sections, timestamp: $json.timestamp } }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "n8n_webhook_secret_2024"
            }
          ]
        }
      },
      "id": "wr5",
      "name": "推送报告",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        950,
        350
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "每周一9点": {
      "main": [
        [
          {
            "node": "获取用量统计",
            "type": "main",
            "index": 0
          },
          {
            "node": "获取审计日志",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "手动Webhook": {
      "main": [
        [
          {
            "node": "获取用量统计",
            "type": "main",
            "index": 0
          },
          {
            "node": "获取审计日志",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "获取用量统计": {
      "main": [
        [
          {
            "node": "生成报告",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "生成报告",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "获取审计日志": {
      "main": [
        [
          {
            "node": "生成报告",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "生成报告",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "生成报告": {
      "main": [
        [
          {
            "node": "推送报告",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Asia/Shanghai"
  },
  "tags": [
    "report",
    "用量",
    "每周",
    "定时"
  ]
}