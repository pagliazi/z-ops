{
  "name": "紧急重启 v2 (审批流)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "emergency-reboot",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "er1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst params = input.params || input;\nconst cstTime = new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });\n\nreturn {\n  target: params.target || '',\n  reason: params.reason || '未说明原因',\n  force: params.force || false,\n  triggered_by: input.triggered_by || 'zops_api',\n  timestamp: cstTime,\n};"
      },
      "id": "er2",
      "name": "解析参数",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:7789/api/n8n/webhook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'approval_request', request_type: 'emergency_reboot', title: `🚨 紧急重启: ${$json.target}`, content: `目标: ${$json.target}\\n原因: ${$json.reason}\\n强制: ${$json.force ? '是' : '否'}\\n请求人: ${$json.triggered_by}\\n时间: ${$json.timestamp}\\n\\n⚠️ 紧急操作，请尽快审批！`, callback_url: 'http://localhost:7789/api/webhook/n8n_callback' }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "n8n_webhook_secret_2024"
            }
          ]
        }
      },
      "id": "er3",
      "name": "发送审批",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, target: $json.target, status: 'pending_approval', message: `紧急重启请求已发送审批 (${$json.target})` }) }}"
      },
      "id": "er4",
      "name": "响应",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "解析参数",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "解析参数": {
      "main": [
        [
          {
            "node": "发送审批",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "发送审批": {
      "main": [
        [
          {
            "node": "响应",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Asia/Shanghai"
  },
  "tags": [
    "approval",
    "紧急",
    "重启",
    "高危操作"
  ]
}