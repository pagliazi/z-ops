{
  "name": "备份恢复 v2 (审批流)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "backup-restore",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "br1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst params = input.params || input;\nconst cstTime = new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });\n\nreturn {\n  gid: params.gid || '',\n  backup_id: params.backup_id || '',\n  target_date: params.target_date || '',\n  triggered_by: input.triggered_by || 'zops_api',\n  timestamp: cstTime,\n};"
      },
      "id": "br2",
      "name": "解析参数",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:7789/api/n8n/webhook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'approval_request', request_type: 'backup_restore', title: `备份恢复: GID ${$json.gid}`, content: `GID: ${$json.gid}\\n备份ID: ${$json.backup_id}\\n目标日期: ${$json.target_date}\\n请求人: ${$json.triggered_by}\\n时间: ${$json.timestamp}\\n\\n⚠️ 此操作将覆盖当前数据！`, callback_url: 'http://localhost:7789/api/webhook/n8n_callback' }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "n8n_webhook_secret_2024"
            }
          ]
        }
      },
      "id": "br3",
      "name": "发送审批",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, gid: $json.gid, status: 'pending_approval', message: `备份恢复请求已提交审批 (GID: ${$json.gid})` }) }}"
      },
      "id": "br4",
      "name": "响应",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "解析参数",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "解析参数": {
      "main": [
        [
          {
            "node": "发送审批",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "发送审批": {
      "main": [
        [
          {
            "node": "响应",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Asia/Shanghai"
  },
  "tags": [
    "gcoc",
    "备份",
    "恢复",
    "审批",
    "高危操作"
  ]
}