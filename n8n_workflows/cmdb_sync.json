{
  "name": "CMDB同步 v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cmdb-sync",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "cs1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst params = input.params || input;\nconst syncMode = params.sync_mode || 'incremental';\nconst cstTime = new Date().toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai' });\n\nreturn {\n  sync_mode: syncMode,\n  triggered_by: input.triggered_by || 'zops_api',\n  timestamp: cstTime,\n};"
      },
      "id": "cs2",
      "name": "解析参数",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:7789/api/opscore/cmdb/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-N8N-Key",
              "value": "n8n_webhook_secret_2024"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sync_mode: $json.sync_mode }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "cs3",
      "name": "执行CMDB同步",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "http://localhost:7789/api/n8n/webhook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'workflow_result', workflow_id: 'cmdb_sync', sync_mode: $json.sync_mode, status: 'completed', timestamp: $json.timestamp }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Key",
              "value": "n8n_webhook_secret_2024"
            }
          ]
        }
      },
      "id": "cs4",
      "name": "结果回调",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        850,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, sync_mode: $json.sync_mode, message: `CMDB ${$json.sync_mode} 同步已完成` }) }}"
      },
      "id": "cs5",
      "name": "响应",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "解析参数",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "解析参数": {
      "main": [
        [
          {
            "node": "执行CMDB同步",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "执行CMDB同步": {
      "main": [
        [
          {
            "node": "结果回调",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "响应",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "结果回调": {
      "main": [
        [
          {
            "node": "响应",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Asia/Shanghai"
  },
  "tags": [
    "opscore",
    "cmdb",
    "同步"
  ]
}