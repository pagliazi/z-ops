# ═══ Z-OPS N8N 集成配置 ═══

# N8N 服务配置
N8N_ENABLED=
N8N_URL=
N8N_API_KEY=
N8N_WEBHOOK_KEY=

# N8N 工作流触发
N8N_WORKFLOW_TRIGGER_ENABLED=

# N8N 可触发的工作流 ID
N8N_TRIGGER_WORKFLOW_IDS=

# N8N 回调配置
N8N_WEBHOOK_URL=

# 定时任务同步 (从 N8N 同步定时任务到 Z-OPS)
N8N_CRON_SYNC_ENABLED=
N8N_CRON_SYNC_INTERVAL=

# 通知配置 (通过 N8N 发送通知)
N8N_NOTIFICATION_WEBHOOK=
