# ═══ Z-OPS 飞书通道配置 ═══
FEISHU_WEBHOOK_URL=

# [可选] 应用机器人（配置后可实现群内 @机器人 交互，如 "nms 状态"、"nms 截图 OPSCORE_use"）
# 需在飞书开放平台创建企业自建应用：开通机器人能力 + 事件订阅（im.message.receive_v1）
# 回调地址: https://<公网域名>/feishu/event（由 feishu_bot 事件接收服务处理，见 FEISHU_EVENT_PORT）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 事件接收服务监听端口（需公网可达或被 nginx 反向代理到 /feishu/event）
FEISHU_EVENT_PORT=8003

REDIS_URL=
